{
  "name": "release-suite",
  "version": "3.2.0",
  "description": "Semantic versioning and release automation toolkit for Git-based projects.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rs-version": "bin/version.js",
    "rs-changelog": "bin/changelog.js",
    "rs-release-notes": "bin/release-notes.js",
    "rs-dry-run": "bin/dry-run.js",
    "rs-tag": "bin/tag.js"
  },
  "scripts": {
    "lint": "eslint bin/",
    "lint:fix": "eslint bin/ --fix",
    "format": "prettier . --write",
    "dry-run": "node bin/dry-run.js create",
    "dry-run:clean": "node bin/dry-run.js remove",
    "version:compute": "node bin/version.js compute",
    "changelog": "node bin/changelog.js generate",
    "release-notes": "node bin/release-notes.js generate",
    "tag:create": "node bin/tag.js create",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonasmzsouza/release-suite"
  },
  "keywords": [
    "release",
    "tools",
    "semantic",
    "versioning",
    "changelog",
    "release-notes",
    "publish",
    "npm",
    "nodejs"
  ],
  "author": {
    "name": "Jonas Souza",
    "email": "jonasmzsouza@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jonasmzsouza/release-suite/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "eslint": "9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  }
}
